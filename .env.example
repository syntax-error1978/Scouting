# Kopieer dit bestand naar .env en vul een eigen geheime waarde in.
# ADMIN_TOKEN is nodig om via de API nieuwe kwekerijen (locaties) aan te maken
# (POST /api/locations met header X-Admin-Token). Bewaar deze veilig — iedereen
# met dit token kan nieuwe locaties en toegangscodes aanmaken.
ADMIN_TOKEN=verzin-hier-een-lang-willekeurig-token
